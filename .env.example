# Database 
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=loan_management
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change-me-to-a-strong-random-64-char-secret
JWT_EXPIRY_MS=43200000

# AI (optional — empty key = template fallback)
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# CORS
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000